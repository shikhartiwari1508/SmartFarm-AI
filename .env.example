# SmartFarm AI - Environment Variables
# Copy this file to .env and fill in your values

# --- App Settings ---
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./smartfarm.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/smartfarm

# --- Weather API (optional) ---
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
WEATHER_DEMO_MODE=true

# --- AI/ML Settings ---
ML_DEMO_MODE=true
# Set to false and provide model paths to use real trained models
CROP_MODEL_PATH=./models/crop_recommendation_model.pkl
DISEASE_MODEL_PATH=./models/disease_detection_model.h5

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=./uploads

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Gemini AI (optional, for enhanced chatbot) ---
GEMINI_API_KEY=your_gemini_api_key_here
CHAT_DEMO_MODE=true
